# Cloudflare Pages response headers.
# CSS/JS/data files are always linked with a content-hash (?v=…) by tools/build-guides.js,
# so they can be cached for a year; a changed file gets a new URL automatically.
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
/assets/data/*
  Cache-Control: public, max-age=31536000, immutable
# Images keep their file names when replaced, so cache them for a week only.
/assets/img/*
  Cache-Control: public, max-age=604800
